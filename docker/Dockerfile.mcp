FROM node:24.22.3-alpine AS base

WORKDIR /app

# pnpm-workspace.yaml carries the pnpm settings, which pnpm 11+ reads nowhere else, among
# them the dependency build scripts an install may run. The server runs from its sources,
# which import production dependencies only.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile --prod

COPY --chown=node:node . .

USER node

EXPOSE 4545

CMD ["node", "--experimental-strip-types", "./services/code-intel-mcp/src/server.ts"]
